{
  "name": "ga-pubsub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GA-PubSub \u2014 Enterprise-grade, security-first, transport-agnostic eventing platform",
  "workspaces": [
    "packages/core",
    "packages/broadcast-channel",
    "packages/kafka",
    "packages/nats",
    "packages/rabbitmq",
    "packages/redis",
    "packages/sse",
    "packages/websocket"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --exclude 'tests/integration/transports.test.ts'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:stress": "vitest run tests/stress",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration/integration.test.ts",
    "test:transports": "vitest run tests/integration/transports.test.ts",
    "test:unit": "vitest run tests/unit",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint 'packages/*/src/**/*.ts' --fix",
    "docs": "typedoc --out docs/api packages/core/src/index.ts",
    "changeset": "changeset",
    "release": "changeset publish",
    "clean": "find . -name 'dist' -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; true",
    "clean:all": "npm run clean && find . -name 'node_modules' -maxdepth 2 -exec rm -rf {} + 2>/dev/null; true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "pubsub",
    "event-bus",
    "eventing",
    "message-bus",
    "enterprise",
    "security",
    "transport-agnostic",
    "websocket",
    "redis",
    "kafka",
    "nats",
    "rabbitmq",
    "serverless",
    "edge",
    "typescript"
  ],
  "author": "Ajithraj G",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ga-pubsub/ga-pubsub.git"
  },
  "bugs": {
    "url": "https://github.com/ga-pubsub/ga-pubsub/issues"
  },
  "homepage": "https://deslay-ai.web.app/ga-pubsub"
}
