{
  "name": "ga-pubsub",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "GA-PubSub Core \u2014 free browser-only, in-memory pub/sub for TypeScript",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint 'packages/*/src/**/*.ts' --fix",
    "docs": "typedoc --out docs/api packages/core/src/index.ts",
    "changeset": "changeset",
    "release": "changeset publish",
    "clean": "find . -name 'dist' -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; true",
    "clean:all": "npm run clean && find . -name 'node_modules' -maxdepth 2 -exec rm -rf {} + 2>/dev/null; true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "pubsub",
    "event-bus",
    "eventing",
    "message-bus",
    "browser",
    "in-memory",
    "typescript"
  ],
  "author": "Ajithraj G",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ga-pubsub/ga-pubsub.git"
  },
  "bugs": {
    "url": "https://github.com/ga-pubsub/ga-pubsub/issues"
  },
  "homepage": "https://deslay-ai.web.app/ga-pubsub"
}
