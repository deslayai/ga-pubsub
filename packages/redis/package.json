{
  "name": "@ga-pubsub/redis",
  "version": "1.0.0",
  "description": "Redis Pub/Sub and Streams transport adapter for GA-PubSub",
  "type": "module",
  "main":  "./dist/index.js",
  "module":"./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsc", "dev": "tsc --watch" },
  "peerDependencies": {
    "ga-pubsub": "^1.0.0",
    "ioredis":   "^5.0.0"
  },
  "peerDependenciesMeta": { "ioredis": { "optional": false } },
  "devDependencies": { "ioredis": "^5.0.0", "@types/node": "^20.0.0" },
  "keywords": ["ga-pubsub", "redis", "pub-sub", "streams", "transport"],
  "license": "MIT"
}
