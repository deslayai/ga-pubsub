{
  "name": "@ga-pubsub/nats",
  "version": "1.0.0",
  "description": "NATS Core and JetStream transport adapter for GA-PubSub",
  "type": "module",
  "main":  "./dist/index.js",
  "module":"./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsc", "dev": "tsc --watch" },
  "peerDependencies": {
    "ga-pubsub": "^1.0.0",
    "nats":       "^2.0.0"
  },
  "peerDependenciesMeta": { "nats": { "optional": false } },
  "devDependencies": { "nats": "^2.0.0", "@types/node": "^20.0.0" },
  "keywords": ["ga-pubsub", "nats", "jetstream", "messaging", "transport"],
  "license": "MIT"
}
