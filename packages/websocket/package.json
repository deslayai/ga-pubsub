{
  "name": "@ga-pubsub/websocket",
  "version": "1.0.0",
  "description": "WebSocket transport adapter for GA-PubSub — JWT auth, TLS, heartbeat, auto-reconnect",
  "type": "module",
  "main":  "./dist/index.js",
  "module":"./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsc", "dev": "tsc --watch" },
  "peerDependencies": { "ga-pubsub": "^1.0.0" },
  "keywords": ["ga-pubsub", "websocket", "transport", "realtime"],
  "license": "MIT"
}
