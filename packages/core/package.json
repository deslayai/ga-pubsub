{
  "name": "ga-pubsub",
  "version": "3.1.2",
  "description": "GA-PubSub Core \u2014 free pub/sub event bus for TypeScript (Elastic License 2.0)",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./validators": {
      "import": "./dist/validators.js",
      "require": "./dist/cjs/validators.js",
      "types": "./dist/validators.d.ts"
    },
    "./integrations": {
      "import": "./dist/integrations.js",
      "require": "./dist/cjs/integrations.js",
      "types": "./dist/integrations.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts/prepare.mjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-cjs.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run build && npm run verify:package",
    "prepublishOnly": "npm test",
    "verify:package": "node scripts/verify-package.mjs",
    "pack": "npm run build && npm pack"
  },
  "sideEffects": false,
  "keywords": [
    "pubsub",
    "event-bus",
    "events",
    "messaging",
    "typescript",
    "browser",
    "in-memory",
    "wildcard",
    "middleware",
    "schema-validation",
    "replay"
  ],
  "author": "Ajithraj G",
  "license": "Elastic-2.0",
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ga-pubsub/ga-pubsub.git",
    "directory": "packages/core"
  },
  "homepage": "https://deslay-ai.web.app/ga-pubsub",
  "bugs": {
    "url": "https://deslay-ai.web.app/community"
  }
}
