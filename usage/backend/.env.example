# GA-PubSub Core Demo — Backend
# Copy to .env for local dev, or set as env vars in production

PORT=3001
NODE_ENV=development   # set to "production" in prod

# ── REQUIRED IN PRODUCTION ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SIGNING_SECRET=

# Your deployed frontend URL (e.g. https://YOUR_ORG.github.io)
CORS_ORIGIN=http://localhost:5173

# ── OPTIONAL TRANSPORTS ───────────────────────────────────────────────────────
# Redis (leave blank to skip)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka (leave blank to skip)
KAFKA_BROKERS=localhost:9092

LOG_LEVEL=info
